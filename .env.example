# Required for live LLM/OCR flows
OPENAI_API_KEY=

# Model tiers
LLM_MODEL=o4-mini-2025-04-16
LLM_MODEL_MINI=gpt-5.4-mini-2026-03-17
LLM_MODEL_NANO=gpt-5.4-nano-2026-03-17
VISION_LLM_MODEL=gpt-5.4
EXAM_SOLVER_MODEL=o4-mini-2025-04-16
EMBEDDING_MODEL=text-embedding-3-small

# Local defaults
DATABASE_URL=sqlite+aiosqlite:///./data/tutor.db

# Docker Compose Postgres (chỉ dùng khi chạy docker compose; đổi password khi deploy)
POSTGRES_USER=aitutor
POSTGRES_PASSWORD=aitutorpassword
POSTGRES_DB=aitutordb
CHROMA_PERSIST_DIR=./data/chroma_db
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_K=5
RERANKER_CANDIDATE_K=20

# Agent/OCR behavior
USE_FUNCTION_CALLING=false
FUNCTION_CALLING_MAX_ROUNDS=5
# Engine LangGraph (app/graph/*); đặt false để rollback về Orchestrator cũ
USE_LANGGRAPH=true
# Ngưỡng confidence để verdict LLM-only (CAS không kiểm chứng được) ghi vào BKT
GRADING_CONFIDENCE_THRESHOLD=0.75
OCR_ENGINE=cloud
MAX_EXAM_PAGES=20
SOLVE_CONCURRENCY=5

# Guardrails
GUARDRAILS_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200
MAX_MESSAGE_LENGTH=4000

# Optional S3
S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=aitutor-bucket-vn

# Optional Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
